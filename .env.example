# ============================================================
# Environment Configuration — RAG Chat PDF
# Techtaru Digital
#
# Copy this file to .env and fill in your values.
#   cp .env.example .env
# ============================================================

# ── LLM provider ─────────────────────────────────────────────
# Supported: "gemini" (free tier, default) | "openai" | "anthropic"
LLM_PROVIDER=gemini

# Optional: override the model. Leave blank for the default.
#   gemini    → gemini-2.5-flash
#   openai    → gpt-4o
#   anthropic → claude-sonnet-4-20250514
LLM_MODEL=

# ── API key for the chosen provider ──────────────────────────
# Only the key matching LLM_PROVIDER is required.
#   gemini (free): https://aistudio.google.com/apikey
#   openai:        https://platform.openai.com/api-keys
#   anthropic:     https://console.anthropic.com/
GOOGLE_API_KEY=your-google-api-key-here
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# ── Optional: LangSmith observability ────────────────────────
# LANGCHAIN_TRACING_V2=true
# LANGCHAIN_API_KEY=your-langsmith-api-key-here
# LANGCHAIN_PROJECT=techtaru-rag-pdf
